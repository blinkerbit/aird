{
  "name": "aird-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend build tooling for Aird (dev-only, not shipped)",
  "scripts": {
    "css:build": "npx @tailwindcss/cli -i ./src/input.css -o ./aird/static/css/app.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./src/input.css -o ./aird/static/css/app.css --watch",
    "lint:js": "eslint aird/static/js",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "js:share": "node scripts/build-share.mjs",
    "js:share:watch": "node scripts/build-share.mjs --watch",
    "js:build": "npm run js:core && npm run js:share",
    "prejs:core": "node scripts/gen-core-shim.mjs",
    "js:core": "node scripts/build-core.mjs",
    "js:core:watch": "node scripts/build-core.mjs --watch",
    "js:browse": "esbuild aird/static/js/browse/app.js --bundle --platform=browser --format=esm --outfile=aird/static/js/browse/app.bundle.js",
    "js:browse:watch": "esbuild aird/static/js/browse/app.js --bundle --platform=browser --format=esm --outfile=aird/static/js/browse/app.bundle.js --watch",
    "js:pages": "esbuild aird/static/js/pages/p2p-page.js aird/static/js/pages/super-search.js --bundle --platform=browser --format=esm --outdir=aird/static/js/pages/dist --entry-names=[name].bundle",
    "js:pages:watch": "esbuild aird/static/js/pages/p2p-page.js aird/static/js/pages/super-search.js --bundle --platform=browser --format=esm --outdir=aird/static/js/pages/dist --entry-names=[name].bundle --watch",
    "vendor:qrcode": "esbuild node_modules/qrcode/lib/browser.js --bundle --platform=browser --format=iife --global-name=AirdQRCode --outfile=aird/static/js/vendor/qrcode-browser.js",
    "vendor:fflate": "esbuild node_modules/fflate/umd/index.js --bundle --platform=browser --format=iife --global-name=fflate --outfile=aird/static/js/vendor/fflate.js",
    "vendor:livekit": "esbuild node_modules/livekit-client/dist/livekit-client.esm.mjs --bundle --platform=browser --format=esm --outfile=aird/static/js/vendor/livekit-client.bundle.js",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/cli": "^4",
    "daisyui": "^5",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fflate": "^0.8.2",
    "globals": "^17",
    "happy-dom": "^20.14.6",
    "livekit-client": "^2.23.0",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "vitest": "^5"
  }
}
